+        name.eq_ignore_ascii_case("host").then_some(value.trim())
+    }).collect();
+    if hosts != [authority] { return None; }
+    match expected.parse_callback(query) {
+        Ok(_) => Some((query, false)),
+        Err(CallbackError::Denied(_)) => Some((query, true)),
+        Err(_) => None,
+    }
